rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }
    function isNonEmptyString(v) {
      return v is string && v.size() > 0;
    }
    function isNonNegNumber(v) {
      return v is number && v >= 0;
    }

    function storeDoc(storeId) {
      return get(/databases/$(database)/documents/stores/$(storeId)).data;
    }

    function storeExists(storeId) {
      return exists(/databases/$(database)/documents/stores/$(storeId));
    }

    // Membership lists present and non-empty.
    function hasMembershipList(storeId) {
      return storeExists(storeId)
        && storeDoc(storeId).keys().hasAny(['memberUids'])
        && storeDoc(storeId).memberUids is list
        && storeDoc(storeId).memberUids.size() > 0;
    }

    function isStoreMember(storeId) {
      return isSignedIn()
        && hasMembershipList(storeId)
        && uid() in storeDoc(storeId).memberUids;
    }

    function isStoreOwner(storeId) {
      return isSignedIn()
        && storeExists(storeId)
        && storeDoc(storeId).keys().hasAny(['ownerUid'])
        && storeDoc(storeId).ownerUid == uid();
    }

    // Pre-membership stores (broken after rules rollout): signed-in users may
    // read and claim ownership once by setting ownerUid + memberUids to self.
    function isLegacyUnclaimed(storeId) {
      return isSignedIn()
        && storeExists(storeId)
        && !hasMembershipList(storeId);
    }

    function isLegacyClaim(storeId) {
      return isLegacyUnclaimed(storeId)
        && request.resource.data.ownerUid == uid()
        && request.resource.data.memberUids is list
        && uid() in request.resource.data.memberUids;
    }

    // App used local demo_phone_* / fb_demo_* uids without Firebase Auth.
    // After Anonymous rebind, allow reclaiming those stores once.
    function isSyntheticDemoOwner(storeId) {
      return storeExists(storeId)
        && storeDoc(storeId).keys().hasAny(['ownerUid'])
        && storeDoc(storeId).ownerUid is string
        && (
          storeDoc(storeId).ownerUid.matches('demo_phone_.*')
          || storeDoc(storeId).ownerUid.matches('fb_demo_.*')
        );
    }

    function isDemoReclaim(storeId) {
      return isSignedIn()
        && isSyntheticDemoOwner(storeId)
        && request.resource.data.ownerUid == uid()
        && request.resource.data.memberUids is list
        && uid() in request.resource.data.memberUids;
    }

    function canAccessStore(storeId) {
      return isStoreMember(storeId)
        || isStoreOwner(storeId)
        || isLegacyUnclaimed(storeId)
        || isSyntheticDemoOwner(storeId);
    }

    function isBusinessOwner(businessId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerUid
          == uid();
    }

    function isBusinessMember(businessId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/businesses/$(businessId)/members/$(uid()));
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && uid() == userId;
    }

    match /businesses/{businessId} {
      allow read: if isBusinessMember(businessId) || isBusinessOwner(businessId);
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == uid();
      allow update: if isBusinessOwner(businessId);
      allow delete: if false;

      match /members/{memberUid} {
        allow read: if isBusinessMember(businessId) || isBusinessOwner(businessId);
        allow write: if isBusinessOwner(businessId)
          || (isSignedIn() && memberUid == uid()
              && request.resource.data.role == 'owner'
              && request.resource.data.uid == uid());
      }

      match /catalog/{productId} {
        allow read: if isBusinessMember(businessId) || isBusinessOwner(businessId);
        allow write: if isBusinessOwner(businessId) || isBusinessMember(businessId);
      }
    }

    match /products/{productId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && isNonEmptyString(request.resource.data.name)
        && request.resource.data.barcode is string
        && isNonNegNumber(request.resource.data.sellingPrice)
        && isNonNegNumber(request.resource.data.costPrice)
        && request.resource.data.markup is number;
      allow delete: if false;
    }

    match /stores/{storeId} {
      // get of a missing doc must succeed so activate/create-branch can probe
      // existence. Existing docs require membership/ownership (or demo reclaim).
      allow get: if isSignedIn() && (
        !exists(/databases/$(database)/documents/stores/$(storeId))
        || canAccessStore(storeId)
      );
      // listMemberStores uses ownerUid / memberUids filters.
      allow list: if isSignedIn()
        && resource.data.keys().hasAny(['ownerUid'])
        && (
          resource.data.ownerUid == uid()
          || (
            resource.data.keys().hasAny(['memberUids'])
            && resource.data.memberUids is list
            && uid() in resource.data.memberUids
          )
          || (
            resource.data.ownerUid is string
            && (
              resource.data.ownerUid.matches('demo_phone_.*')
              || resource.data.ownerUid.matches('fb_demo_.*')
            )
          )
          || !(
            resource.data.keys().hasAny(['memberUids'])
            && resource.data.memberUids is list
            && resource.data.memberUids.size() > 0
          )
        );

      allow create: if isSignedIn()
        && request.resource.data.ownerUid == uid()
        && request.resource.data.memberUids is list
        && uid() in request.resource.data.memberUids
        && isNonEmptyString(request.resource.data.name)
        && isNonEmptyString(request.resource.data.storeId);
      allow update: if isStoreOwner(storeId)
        || isStoreMember(storeId)
        || isLegacyClaim(storeId)
        || isDemoReclaim(storeId)
        || (isSignedIn()
            && resource.data.keys().hasAny(['passcode'])
            && request.resource.data.keys().hasAny(['passcode'])
            && request.resource.data.passcode == resource.data.passcode
            && request.resource.data.ownerUid == resource.data.ownerUid);
      allow delete: if isStoreOwner(storeId);

      // Subcollections: allow bootstrap writes when parent store is missing only
      // during the same activation race is unsafe — require canAccessStore.
      // Exception: signed-in creator may write settings/devices right after
      // create if they own the parent (canAccessStore once parent exists).
      match /devices/{deviceId} {
        allow read, create: if canAccessStore(storeId);
        allow update: if isStoreOwner(storeId) || (canAccessStore(storeId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'isApproved']));
        allow delete: if isStoreOwner(storeId) || (canAccessStore(storeId) && resource.data.deviceId == request.auth.uid);
      }

      match /products/{productId} {
        allow read: if canAccessStore(storeId);
        allow create, update: if canAccessStore(storeId)
          && isNonEmptyString(request.resource.data.name)
          && request.resource.data.barcode is string
          && isNonNegNumber(request.resource.data.sellingPrice)
          && isNonNegNumber(request.resource.data.costPrice)
          && request.resource.data.markup is number;
        allow delete: if isStoreOwner(storeId) || isStoreMember(storeId);
      }

      match /settings/{docId} {
        allow read: if canAccessStore(storeId)
          || (isSignedIn()
              && !exists(/databases/$(database)/documents/stores/$(storeId)));
        allow write: if canAccessStore(storeId);
      }

      match /sales/{saleId} {
        allow read: if canAccessStore(storeId);
        allow create: if canAccessStore(storeId)
          && isNonNegNumber(request.resource.data.totalPrice);
        allow update: if isStoreOwner(storeId) || isStoreMember(storeId);
        allow delete: if false;
      }

      match /invoices/{invoiceId} {
        allow read: if canAccessStore(storeId);
        allow create, update: if canAccessStore(storeId)
          && isNonNegNumber(request.resource.data.total)
          && request.resource.data.payment in ['cash', 'credit', 'online'];
        allow delete: if false;
      }

      match /deposits/{depositId} {
        allow read: if canAccessStore(storeId);
        allow create, update: if canAccessStore(storeId)
          && isNonNegNumber(request.resource.data.amount)
          && request.resource.data.payment in ['cash', 'online'];
        allow delete: if false;
      }

      match /customers/{phone} {
        allow read: if canAccessStore(storeId);
        allow create, update: if canAccessStore(storeId)
          && isNonEmptyString(request.resource.data.phone)
          && isNonEmptyString(request.resource.data.name);
        allow delete: if false;
      }

      match /inventory_logs/{logId} {
        allow read: if canAccessStore(storeId);
        allow create, update: if canAccessStore(storeId);
        allow delete: if false;
      }

      match /vendors/{vendorId} {
        allow read: if canAccessStore(storeId);
        allow create, update: if canAccessStore(storeId);
        allow delete: if false;
      }

      match /vendor_invoices/{invoiceId} {
        allow read: if canAccessStore(storeId);
        allow create, update: if canAccessStore(storeId);
        allow delete: if false;
      }
    }

    match /{path=**}/vendors/{vendorId} {
      allow read: if isSignedIn();
    }
  }
}
